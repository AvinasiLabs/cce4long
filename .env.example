# Storage backend: "local" or "s3"
CCED_STORAGE_BACKEND=local

# Local storage
CCED_STORAGE_DIR=/tmp/cced

# S3 / GCS (required when CCED_STORAGE_BACKEND=s3)
CCED_S3_BUCKET=your-bucket-name
CCED_S3_REGION=auto
CCED_S3_ENDPOINT=https://storage.googleapis.com
CCED_S3_ACCESS_KEY=your-access-key
CCED_S3_SECRET_KEY=your-secret-key

# Logging
RUST_LOG=cced=info
