# JuiceFS metadata URL — shared between PP-side Redis and CVM-side JuiceFS
CCED_JFS_META_URL=redis://localhost:6379/1

# JuiceFS Gateway S3 credentials (PP-side, for dataset read/write)
JFS_BUCKET=avinasi
JFS_REGION=auto
JFS_ENDPOINT=http://localhost:9000
JFS_ACCESS_KEY=admin
JFS_SECRET_KEY=changeme123

# GCS HMAC credentials (CVM-side, JuiceFS data backend)
GCS_ACCESS_KEY=your-gcs-hmac-access-key
GCS_SECRET_KEY=your-gcs-hmac-secret-key
GCS_BUCKET_URL=https://storage.googleapis.com/your-bucket-name

# DStack simulator endpoint (omit for real TEE)
# DSTACK_SIMULATOR_ENDPOINT=/path/to/dstack.sock

# PCCS URL for DCAP verification (requires --features dcap)
# PCCS_URL=https://localhost:8081/sgx/certification/v4

RUST_LOG=cced=info,tee_agent=info
