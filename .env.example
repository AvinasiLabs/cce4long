# Privacy Plane (cced)
# CCE_ROOT_KEY=
# Storage backend: "local" or "s3"
CCED_STORAGE_BACKEND=local
CCED_STORAGE_DIR=/tmp/cced
# CCED_S3_BUCKET=
# CCED_S3_REGION=auto
# CCED_S3_ENDPOINT=https://storage.googleapis.com
# CCED_S3_ACCESS_KEY=
# CCED_S3_SECRET_KEY=

# Computing Plane (tee-agent)
# TEE_AGENT_PP_URL=http://localhost:3000
# TEE_AGENT_CREDENTIAL=
# TEE_AGENT_SUBMIT_CREDENTIAL=
# TEE_AGENT_DATASET_IDS=
# TEE_AGENT_JOB_SPEC=
# TEE_AGENT_DATA_DIR=/data
# TEE_AGENT_OUTPUT_DIR=/output

RUST_LOG=cced=info,tee_agent=info
